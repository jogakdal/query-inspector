<?xml version="1.0"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.acme.UserMapper">
  <resultMap id="userRM" type="User">
    <collection property="orders" ofType="Order" select="OrderMapper.findByUserId"/>
  </resultMap>
  <select id="search" resultMap="userRM">
    SELECT * FROM users
    <where>
      <if test="ids != null">AND id IN
        <foreach item="i" collection="ids" open="(" separator="," close=")">#{i}</foreach>
      </if>
    </where>
  </select>
</mapper>
